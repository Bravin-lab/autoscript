[Unit]
Description=AutoScript Private Auth API
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/autoscript-private-auth
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/autoscript-private-auth/.venv/bin/python /opt/autoscript-private-auth/app.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
