# Build and Release Folders
bin-debug/
bin-release/
[Oo]bj/
[Bb]in/

# Other files and folders
.settings/setup.sh
/addip/register.txt
# Executables
*.swf
*.air
*.ipa
*.apk

# Project files, i.e. `.project`, `.actionScriptProperties` and `.flexProperties`
# should NOT be excluded as they contain compiler settings and other important
# information for Eclipse / Flash Builder.

# Security: local secrets and runtime files
private-auth/config.json
private-auth/licenses.json
private-auth/keys/private.pem
private-auth/keys/*.key

cloudflare-auth/.dev.vars
cloudflare-auth/.env
cloudflare-auth/.env.*

# Optional local customer artifacts (keep examples committed)
cloudflare-auth/licenses/customer*.json
cloudflare-auth/licenses/*.local.json
